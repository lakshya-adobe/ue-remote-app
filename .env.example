# Universal Editor Configuration
# Copy this file to .env and replace the placeholders with your actual values

# AEM Author Instance URL
# Replace <program-id> and <environment-id> with your AEM Cloud Service values
REACT_APP_AEM_URL=https://author-p<program-id>-e<environment-id>.adobeaemcloud.com
REACT_APP_AEM_GRAPHQL_ENDPOINT=https://author-p<program-id>-e<environment-id>.adobeaemcloud.com/content/graphql/global/endpoint.json

# Universal Editor Service
UE_SERVICE_URL=https://universal-editor-service.adobe.io

# CORS Configuration
CORS_ORIGIN=https://experience.adobe.com

# Local Development
LOCAL_DEV_URL=https://localhost:4200

